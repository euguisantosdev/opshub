# Copie para .env (que não deve ser versionado) e troque TODOS os valores.
DB_USER=opshub
DB_PASSWORD=troque-esta-senha
# Mínimo de 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=
# Opcional: cria o primeiro gestor se ainda não houver usuários.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Para uma demonstração com dados fictícios: SPRING_PROFILES_ACTIVE=demo e OPSHUB_DEMO_PASSWORD=<senha>
SPRING_PROFILES_ACTIVE=
OPSHUB_DEMO_PASSWORD=
